<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda_with_cam">
  <xacro:include filename="$(find panda_description)/urdf/panda.urdf.xacro"/>

  <!-- 深度相机固定在 panda_hand -->
  <joint name="camera_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <material name="green"><color rgba="0 1 0 0.7"/></material>

  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <depth>
          <near>0.05</near>
          <far>2.0</far>
        </depth>
      </camera>
      <plugin name="depth_cam_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
        </ros>
        <camera_name>depth_camera</camera_name>
        <image_topic>image_raw</image_topic>
        <depth_image_topic>depth_image_raw</depth_image_topic>
        <info_topic>camera_info</info_topic>
      </plugin>
    </sensor>
  </gazebo>
</robot>
